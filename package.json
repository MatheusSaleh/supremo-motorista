{
  "name": "esplanada-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "desktop": "npm run build && node electron/launch.mjs",
    "desktop:dev": "node electron/launch.mjs --dev",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "terrain": "node scripts/fetch-terrain.mjs",
    "dist:web": "npm run build && node scripts/zip-web.mjs",
    "sync": "node scripts/sync-repos.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.186.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "electron/main.cjs",
  "productName": "Supremo Motorista",
  "description": "Supremo Motorista — sátira arcade em Brasília",
  "author": {
    "name": "Matheus Saleh",
    "email": "100796455+MatheusSaleh@users.noreply.github.com"
  },
  "build": {
    "appId": "br.supremomotorista.jogo",
    "productName": "Supremo Motorista",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "maintainer": "Matheus Saleh <100796455+MatheusSaleh@users.noreply.github.com>"
    },
    "deb": {
      "packageName": "supremo-motorista",
      "artifactName": "supremo-motorista_${version}_${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.racing-games",
      "icon": "build/icon.png"
    },
    "executableName": "supremo-motorista"
  },
  "desktopName": "supremo-motorista.desktop",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/MatheusSaleh/supremo-motorista"
}
