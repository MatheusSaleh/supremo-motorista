# Nginx da VPS -> multiplayer (127.0.0.1:8787). Ver "Instalar na VPS" em docs/MULTIPLAYER.md.
#   sudo cp server/nginx.conf.example /etc/nginx/sites-available/mp.matheussaleh.com.br
#   sudo ln -s /etc/nginx/sites-available/mp.matheussaleh.com.br /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Supõe o Cloudflare na frente (proxy laranja) e o IP real do visitante já restaurado no Nginx:
#   set_real_ip_from <faixas do Cloudflare>;   real_ip_header CF-Connecting-IP;
# Sem isso, os limites por IP abaixo valeriam para o Cloudflare inteiro.

# Conexões abertas e novas conexões por IP (o servidor não conhece o IP do jogador).
limit_conn_zone $binary_remote_addr zone=mp_conn:10m;
limit_req_zone  $binary_remote_addr zone=mp_handshake:10m rate=20r/m;

server {
    listen 80;
    listen [::]:80;
    server_name mp.matheussaleh.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mp.matheussaleh.com.br;

    # Certificado de origem do Cloudflare (SSL/TLS -> Origin Server), modo "Full (strict)".
    ssl_certificate     /etc/ssl/cloudflare/matheussaleh-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/matheussaleh-origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Só o WebSocket na raiz chega ao servidor; qualquer outra coisa é fechada sem resposta.
    location = / {
        if ($http_upgrade !~* ^websocket$) {
            return 444;
        }

        limit_conn mp_conn 4;                               # até 4 abas/jogos por IP
        limit_req  zone=mp_handshake burst=10 nodelay;      # reconexões em rajada

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        return 444;
    }
}
